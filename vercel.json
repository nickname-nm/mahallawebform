{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "xmas.mahalla.berlin"
        }
      ],
      "destination": "/weihnachten/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/proposal/:path*",
      "destination": "https://mahalla-os-os.vercel.app/proposal/:path*"
    },
    {
      "source": "/api/inquiry",
      "destination": "/api/inquiry.js"
    },
    {
      "source": "/api/newsletter",
      "destination": "/api/newsletter.js"
    },
    {
      "source": "/api/volunteer",
      "destination": "/api/volunteer.js"
    },
    {
      "source": "/api/venue-info",
      "destination": "/api/venue-info.js"
    },
    {
      "source": "/api/rsvp",
      "destination": "/api/rsvp.js"
    },
    {
      "source": "/test",
      "destination": "/test.html"
    }
  ]
}
